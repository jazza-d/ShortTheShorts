{
  "name": "shorter-shorts",
  "version": "0.1.0",
  "private": true,
  "description": "Short the Shorts: a tiny puzzle between YouTube Shorts and Instagram Reels to break the doom-scroll. Free, private, no account.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@types/chrome": "^0.3.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
